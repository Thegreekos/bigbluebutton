{
  "name": "bbb-plugin-lgu-activities",
  "version": "0.4.1",
  "private": true,
  "description": "BBB4 LGU Activities identity contract and integration adapter; no game engine or LGU backend calls.",
  "scripts": {
    "build": "webpack --mode production && node scripts/build-manifest.cjs",
    "build-bundle": "npm run build",
    "stage:player": "node scripts/stage-player-artifact.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "npm test && npm run build && node scripts/check-bundle.cjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "start": "node scripts/serve-local.cjs"
  },
  "dependencies": {
    "bigbluebutton-html-plugin-sdk": "0.1.26",
    "jose": "6.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "playwright": "1.56.0",
    "react-test-renderer": "18.3.1",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1"
  }
}
